rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get("admin", false) == true;
    }

    function ownsProfile(profileId) {
      return signedIn()
        && (
          request.auth.uid == profileId
          || (resource.data.owners is list && request.auth.uid in resource.data.owners)
        );
    }

    function ownsBookingProfile(profileId) {
      return signedIn()
        && (
          request.auth.uid == profileId
          || (get(/databases/$(database)/documents/proProfiles/$(profileId)).data.owners is list
            && request.auth.uid in get(/databases/$(database)/documents/proProfiles/$(profileId)).data.owners)
        );
    }

    function hasDelegatePermission(profileId, permission) {
      return signedIn()
        && get(/databases/$(database)/documents/proProfiles/$(profileId)).data.get("delegates", {}).get(request.auth.uid, {}).get("status", "") == "active"
        && permission in get(/databases/$(database)/documents/proProfiles/$(profileId)).data.get("delegates", {}).get(request.auth.uid, {}).get("permissions", []);
    }

    function willOwnProfile(profileId) {
      return signedIn()
        && request.auth.uid == profileId
        && request.resource.data.owners is list
        && request.auth.uid in request.resource.data.owners;
    }

    function hasOnlyPublicProfileFields() {
      return request.resource.data.keys().hasOnly([
        "displayName",
        "name",
        "idTag",
        "categories",
        "services",
        "intakeQuestionnaire",
        "scheduleAvailability",
        "shortDescription",
        "visibleFields",
        "avatarUrl",
        "serviceArea",
        "timezone",
        "verified",
        "updatedAt",
        "owners"
      ]);
    }

    function hasSafeScheduleAvailability() {
      return !("scheduleAvailability" in request.resource.data)
        || (
          request.resource.data.scheduleAvailability is map
          && request.resource.data.scheduleAvailability.keys().hasOnly(["workingDays", "startTime", "endTime", "scheduleSettings"])
          && request.resource.data.scheduleAvailability.workingDays is list
          && request.resource.data.scheduleAvailability.startTime is string
          && request.resource.data.scheduleAvailability.endTime is string
          && request.resource.data.scheduleAvailability.scheduleSettings is map
          && request.resource.data.scheduleAvailability.scheduleSettings.keys().hasOnly([
            "method", "slotDurationMinutes", "allowMultipleSlots", "maxSlots",
            "recurrenceAllowed", "maxRecurrences", "activationMode", "activationDate"
          ])
          && request.resource.data.scheduleAvailability.scheduleSettings.method in ["drag", "fixed"]
          && request.resource.data.scheduleAvailability.scheduleSettings.slotDurationMinutes is int
          && request.resource.data.scheduleAvailability.scheduleSettings.slotDurationMinutes >= 15
          && request.resource.data.scheduleAvailability.scheduleSettings.slotDurationMinutes <= 1440
          && request.resource.data.scheduleAvailability.scheduleSettings.allowMultipleSlots is bool
          && request.resource.data.scheduleAvailability.scheduleSettings.maxSlots is int
          && request.resource.data.scheduleAvailability.scheduleSettings.maxSlots >= 1
          && request.resource.data.scheduleAvailability.scheduleSettings.maxSlots <= 20
          && request.resource.data.scheduleAvailability.scheduleSettings.recurrenceAllowed is bool
          && request.resource.data.scheduleAvailability.scheduleSettings.maxRecurrences is int
          && request.resource.data.scheduleAvailability.scheduleSettings.maxRecurrences >= 1
          && request.resource.data.scheduleAvailability.scheduleSettings.maxRecurrences <= 52
          && request.resource.data.scheduleAvailability.scheduleSettings.activationMode in ["permanent", "from-date", "single-day"]
          && request.resource.data.scheduleAvailability.scheduleSettings.activationDate is string
        );
    }

    function keepsAdminPublicFieldsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["verified"]);
    }

    function isSafeBusySlot() {
      return request.resource.data.keys().hasOnly(["start", "end", "status"])
        && request.resource.data.status in ["pending", "accepted", "done", "no-show", "busy"];
    }

    function canClientBookProfessional(proId, clientId) {
      return !exists(/databases/$(database)/documents/proClientRecords/$(proId + "_" + clientId))
        || get(/databases/$(database)/documents/proClientRecords/$(proId + "_" + clientId)).data.get("relationshipStatus", "active") != "blocked";
    }

    function clientBookingUpdate() {
      return request.auth.uid == resource.data.clientId
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "start", "end"])
        && request.resource.data.status in ["pending", "accepted", "rejected"]
        && (resource.data.createdBy != request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
        && (request.resource.data.status != "accepted" || resource.data.createdBy != request.auth.uid);
    }

    function professionalBookingUpdate() {
      return (ownsBookingProfile(resource.data.proId)
        || hasDelegatePermission(resource.data.proId, "manageBookings"))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "statusHistory",
          "start",
          "end",
          "movementQuote",
          "paymentContext",
          "customPrice"
          ,"meetingLinks"
        ])
        && (ownsBookingProfile(resource.data.proId)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "statusHistory", "start", "end", "meetingLinks"]));
    }

    function clientBookingCreate() {
      return request.resource.data.keys().hasOnly([
          "proId",
          "clientId",
          "clientEmail",
          "clientAddress",
          "start",
          "end",
          "service",
          "intakeAnswers",
          "status",
          "createdBy",
          "createdAt"
        ])
        && request.resource.data.clientId == request.auth.uid
        && request.auth.token.get("email_verified", false) == true
        && request.auth.token.get("email", "") is string
        && request.resource.data.clientEmail == request.auth.token.email
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.proId is string
        && canClientBookProfessional(request.resource.data.proId, request.auth.uid);
    }

    function hasActiveHistoryShare(otherUid, scope, scopeId) {
      return signedIn()
        && otherUid != null
        && exists(/databases/$(database)/documents/clientRelationships/$((request.auth.uid < otherUid ? request.auth.uid + "_" + otherUid : otherUid + "_" + request.auth.uid) + "_" + scope + "_" + scopeId))
        && get(/databases/$(database)/documents/clientRelationships/$((request.auth.uid < otherUid ? request.auth.uid + "_" + otherUid : otherUid + "_" + request.auth.uid) + "_" + scope + "_" + scopeId)).data.status == "active";
    }

    function canReadSharedBookingHistory(booking, bookingId) {
      return booking.clientId != null
        && request.auth.uid != booking.clientId
        && (
          hasActiveHistoryShare(booking.clientId, "booking", bookingId)
          || hasActiveHistoryShare(booking.clientId, "professional", booking.proId)
          || hasActiveHistoryShare(booking.clientId, "all", "all")
        );
    }

    function clientRelationshipCreate() {
      return signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.scope in ["booking", "professional", "all"]
        && (request.resource.data.scope != "booking" || request.resource.data.bookingId is string)
        && (request.resource.data.scope != "professional" || request.resource.data.proId is string)
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!("contextLabel" in request.resource.data) || request.resource.data.contextLabel is string)
        && request.resource.data.keys().hasOnly(["requesterUid", "recipientUid", "scope", "bookingId", "proId", "status", "requestedAt", "updatedAt", "contextLabel"]);
    }

    function clientRelationshipApprove() {
      return signedIn()
        && request.auth.uid == resource.data.recipientUid
        && resource.data.status == "pending"
        && request.resource.data.status == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedAt", "updatedAt"])
        && request.resource.data.acceptedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function clientRelationshipRevoke() {
      return signedIn()
        && (request.auth.uid == resource.data.requesterUid || request.auth.uid == resource.data.recipientUid)
        && resource.data.status in ["pending", "active"]
        && request.resource.data.status == "revoked"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "revokedAt", "revokedBy", "updatedAt"])
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicProfiles/{proId} {
      allow read: if true;
      allow create: if willOwnProfile(proId) && hasOnlyPublicProfileFields() && hasSafeScheduleAvailability() && request.resource.data.get("verified", false) != true;
      allow update: if ownsProfile(proId) && hasOnlyPublicProfileFields() && hasSafeScheduleAvailability() && keepsAdminPublicFieldsSafe();
      allow update: if isAdmin() && hasOnlyPublicProfileFields() && hasSafeScheduleAvailability();
      allow delete: if isAdmin();
    }

    match /busySlots/{proId}/slots/{slotId} {
      allow read: if true;
      allow create, update: if isOwner(proId) && isSafeBusySlot();
      allow delete: if isOwner(proId) || isAdmin();
    }

    match /proProfiles/{proId} {
      allow read: if ownsProfile(proId)
        || isAdmin()
        || hasDelegatePermission(proId, "manageBookings")
        || hasDelegatePermission(proId, "manageMessages");
      allow create: if willOwnProfile(proId);
      allow update: if ownsProfile(proId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /clientAccounts/{clientId} {
      allow read, create, update: if isOwner(clientId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
        && (request.resource.data.readAt == null || request.resource.data.readAt is timestamp);
      allow create, delete: if false;
    }

    match /notificationPreferences/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(["messageEmail", "bookingEmail", "reminderEmail", "updatedAt"])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.messageEmail in ["immediate", "digest", "none"]
        && request.resource.data.bookingEmail in ["immediate", "digest", "none"]
        && request.resource.data.reminderEmail in ["immediate", "digest", "none"];
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["messageEmail", "bookingEmail", "reminderEmail", "updatedAt"])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.messageEmail in ["immediate", "digest", "none"]
        && request.resource.data.bookingEmail in ["immediate", "digest", "none"]
        && request.resource.data.reminderEmail in ["immediate", "digest", "none"];
      allow delete: if isAdmin();
    }

    match /legalAcceptances/{acceptanceId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /waitlistEntries/{proId}/entries/{entryId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.clientId || request.auth.uid == proId || isAdmin());
      allow write: if false;
    }

    match /professionalRequests/{requestId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.clientId
          || ownsBookingProfile(resource.data.proId)
          || isAdmin()
          || canReadSharedBookingHistory(resource.data, bookingId)
        );
      allow create: if signedIn() && clientBookingCreate();
      allow update: if isAdmin() || (signedIn() && (clientBookingUpdate() || professionalBookingUpdate()));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/bookings/$(bookingId))
          && (
            request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId
            || ownsBookingProfile(get(/databases/$(database)/documents/bookings/$(bookingId)).data.proId)
            || hasDelegatePermission(get(/databases/$(database)/documents/bookings/$(bookingId)).data.proId, "manageMessages")
            || canReadSharedBookingHistory(get(/databases/$(database)/documents/bookings/$(bookingId)).data, bookingId)
            || isAdmin()
          );
        allow create, update, delete: if false;
      }

      match /private/{privateDocumentId} {
        allow read, write: if isAdmin()
          || (signedIn()
            && exists(/databases/$(database)/documents/bookings/$(bookingId))
            && ownsBookingProfile(get(/databases/$(database)/documents/bookings/$(bookingId)).data.proId));
      }
    }

    match /proClientRecords/{recordId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.proId || isAdmin());
      allow create: if signedIn() && (request.auth.uid == request.resource.data.proId || isAdmin());
      allow update: if signedIn() && (request.auth.uid == resource.data.proId || request.auth.uid == request.resource.data.proId || isAdmin());
      allow delete: if isAdmin();
    }

    match /clientRelationships/{relationshipId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.requesterUid || request.auth.uid == resource.data.recipientUid || isAdmin());
      allow create: if clientRelationshipCreate();
      allow update: if isAdmin() || clientRelationshipApprove() || clientRelationshipRevoke();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || isOwner(resource.data.createdBy);
      allow update: if isAdmin() || (isOwner(resource.data.createdBy)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["subject", "details", "updatedAt"]));
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(["createdBy", "subject", "details", "status", "createdAt", "updatedAt"])
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 120
        && request.resource.data.details is string && request.resource.data.details.size() > 0 && request.resource.data.details.size() <= 2000
        && request.resource.data.status == "pending";
      allow delete: if isAdmin();
    }

    match /dataRequests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.createdBy);
      allow update: if isAdmin() || (isOwner(resource.data.createdBy)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["subject", "details", "updatedAt"]));
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(["createdBy", "subject", "details", "status", "createdAt", "updatedAt"])
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 120
        && request.resource.data.details is string && request.resource.data.details.size() > 0 && request.resource.data.details.size() <= 2000
        && request.resource.data.status == "pending";
      allow delete: if isAdmin();
    }

    match /platformConfig/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /creationLinks/{linkId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /mail/{messageId} {
      allow read, write: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bookingClaimTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /gcalTokens/{proId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
